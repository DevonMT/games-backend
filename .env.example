# ---- Steam ----
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your 64-bit SteamID (the long numeric ID, e.g. 76561197960287930).
# Find it at https://steamid.io/ by pasting your profile URL.
STEAM_USER_ID=

# ---- RAWG ----
# Free API key from https://rawg.io/apidocs (sign up, then "API key").
# Powers the GET /releases endpoint (recent & upcoming releases).
RAWG_API_KEY=

# ---- Database (SQLite via better-sqlite3) ----
# Where the games_table SQLite file lives. Defaults to ./data/games.db locally.
# On Vercel the filesystem is read-only except /tmp, so set this to
# /tmp/games.db there (it behaves as a warm-instance cache, not durable storage).
DATABASE_PATH=./data/games.db

# ---- Postgres (Backlog preferences, Stacks sessions) ----
DATABASE_URL=

# ---- Who is calling (src/middleware/auth.ts) ----
# Proves a request came through the platform gateway, which signs people in and
# sets X-Platform-User. Same value as the gateway's.
GATEWAY_TOKEN=
# Cloudflare Access, the older door; it no longer fronts this service.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Dagster's Learn sync: read-only, GET /learn/sessions and nothing else.
# Same value as LEARN_READ_TOKEN in the data platform's secrets/learn.env.
# Generate with:  openssl rand -hex 32
LEARN_READ_TOKEN=

# ---- AI ----
# No Anthropic key: calls go through the ai-broker on the host, which picks
# subscription vs metered API, enforces the budget and audits every call.
# docker-compose.yml sets BROKER_URL for the deployed container.

# ---- Server ----
PORT=8787
# Comma-separated list of allowed CORS origins for the dashboard.
ALLOWED_ORIGINS=http://localhost:4321,https://devontroedel.com
